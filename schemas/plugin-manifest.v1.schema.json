{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ledger.dev/schemas/plugin-manifest.v1.schema.json",
  "title": "Personal Ledger Bank Importer Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "pluginApiVersion",
    "type",
    "description",
    "author",
    "license",
    "institution",
    "formats",
    "mimeTypes",
    "extensions",
    "entrypoint",
    "accountTypes",
    "capabilities",
    "limits",
    "permissions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "pluginApiVersion": {
      "type": "string",
      "const": "1"
    },
    "type": {
      "type": "string",
      "const": "bank-importer"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "$ref": "#/$defs/author"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "pattern": "^https?://.+"
    },
    "institution": {
      "$ref": "#/$defs/institution"
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["pdf", "csv", "xlsx"]
      }
    },
    "mimeTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\.[a-z0-9]+$"
      }
    },
    "entrypoint": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._/-]+\\.mjs$"
        },
        {
          "not": {
            "type": "string",
            "pattern": "^/|\\.\\."
          }
        }
      ]
    },
    "accountTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["bank", "savings", "spend", "invest", "manual", "coverflex"]
      }
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "permissions": {
      "type": "array",
      "maxItems": 0
    },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      }
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tier": {
      "type": "string",
      "enum": ["official", "community"]
    }
  },
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://.+"
        }
      }
    },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "country"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "pattern": "^([A-Z]{2}|EU|INT)$"
        },
        "legacyNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportsRunningBalance",
        "supportsSourceIds",
        "supportsMultiCurrency",
        "supportsYearInference",
        "supportsInvestments"
      ],
      "properties": {
        "supportsRunningBalance": {
          "type": "boolean"
        },
        "supportsSourceIds": {
          "type": "boolean"
        },
        "supportsMultiCurrency": {
          "type": "boolean"
        },
        "supportsYearInference": {
          "type": "boolean"
        },
        "supportsInvestments": {
          "type": "boolean"
        },
        "supportsSideInvestments": {
          "type": "boolean"
        },
        "supportsBackfill": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manifestOption"
          }
        }
      }
    },
    "manifestOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "type", "default"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["boolean", "enum"]
        },
        "default": {
          "type": ["boolean", "string"]
        },
        "legacyCliDefault": {
          "type": ["boolean", "string"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "boolean"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "default": {
            "type": "boolean"
          },
          "legacyCliDefault": {
            "type": "boolean"
          }
        },
        "not": {
          "required": ["values"]
        }
      },
      "else": {
        "required": ["values"],
        "properties": {
          "default": {
            "type": "string",
            "minLength": 1
          },
          "legacyCliDefault": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFileBytes", "timeoutMs", "maxMemoryMb"],
      "properties": {
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "maxMemoryMb": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

            "type": "object",
            "additionalProperties": false,
            "properties": {
              "symbol": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9 .:_/@+-]*$" },
              "ticker": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9 .:_/@+-]*$" },
              "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
              "isin": { "type": "string", "minLength": 1, "maxLength": 12, "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
              "mic": { "type": "string", "minLength": 1, "maxLength": 4, "pattern": "^[A-Z0-9]{4}$" },
              "currency": { "type": "string", "minLength": 1, "maxLength": 3, "pattern": "^[A-Z]{3}$" },
              "kind": {
                "enum": ["equity", "etf", "fund", "bond", "index", "crypto", "other"]
              },
              "timezone": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z_+-]+(?:/[A-Za-z0-9_+-]+)*$" }
            },
            "required": ["symbol", "ticker", "name", "currency", "kind", "timezone"]
          },
          "maxItems": 1000,
          "minItems": 0

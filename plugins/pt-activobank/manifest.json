{
  "$schema": "../../schemas/plugin-manifest.v1.schema.json",
  "id": "pt-activobank",
  "name": "ActivoBank",
  "version": "1.0.0",
  "pluginApiVersion": "1",
  "type": "bank-importer",
  "tier": "official",
  "description": "Parses ActivoBank Portugal PDF account statements with positioned column detection, statement-level year inference, and running balance extraction.",
  "author": {
    "name": "Personal Ledger"
  },
  "license": "MIT",
  "institution": {
    "id": "activobank",
    "name": "ActivoBank",
    "country": "PT",
    "legacyNames": ["ActivoBank"]
  },
  "formats": ["pdf"],
  "mimeTypes": ["application/pdf"],
  "extensions": [".pdf"],
  "entrypoint": "importer.mjs",
  "accountTypes": ["bank", "savings"],
  "languages": ["pt"],
  "keywords": ["activobank", "portugal", "pdf", "statement"],
  "capabilities": {
    "supportsRunningBalance": true,
    "supportsSourceIds": false,
    "supportsMultiCurrency": false,
    "supportsYearInference": true,
    "supportsInvestments": false,
    "options": []
  },
  "limits": {
    "maxFileBytes": 20971520,
    "timeoutMs": 15000,
    "maxMemoryMb": 128
  },
  "permissions": []
}
